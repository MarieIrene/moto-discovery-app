{
  "expo": {
    "name": "Moto Discovery",
    "slug": "motor-discovery",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "motodiscovery",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "rw.motodiscovery.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Moto Discovery uses your location to show motorcycle taxi drivers near you.",
        "NSCameraUsageDescription": "Moto Discovery uses the camera to take your registration selfie and photos of your ID and driving permit."
      }
    },
    "android": {
      "package": "rw.motodiscovery.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0B4F33"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Moto Discovery uses your location to show motorcycle taxi drivers near you."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Moto Discovery uses the camera to take your registration selfie and photos of your ID and driving permit.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Moto Discovery lets you upload photos of your ID and driving permit.",
          "cameraPermission": "Moto Discovery uses the camera to take photos of your ID and driving permit."
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B4F33"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "967005ef-9dec-4ec2-8c4f-29af3d6c1fd6"
      }
    },
    "owner": "imirene",
    "icon": "./assets/images/icon.png",
    "updates": {
      "url": "https://u.expo.dev/967005ef-9dec-4ec2-8c4f-29af3d6c1fd6"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
